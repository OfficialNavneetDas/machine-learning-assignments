





import pandas as pd
data = pd.read_csv("./data/Salary_dataset.csv",index_col=0)
data.head()





from sklearn.model_selection import train_test_split
x_train,x_test,y_train,y_test=train_test_split(data[["YearsExperience"]],data["Salary"],test_size=0.2,random_state=42)
print("x_train = ",x_train.shape)
print("x_test = ",x_test.shape)





from sklearn.linear_model import LinearRegression
model = LinearRegression()
model.fit(x_train,y_train)





print("β1 slope of the data",model.coef_[0])
print("β2 intercept of the data",model.intercept_)





model.predict([[7]])





# Generate prediction for the x_test
y_pred=model.predict(x_test)
display(y_pred)


# Calculated matrics
from sklearn.metrics import mean_squared_error,r2_score

mse=mean_squared_error(y_test,y_pred)
r2 = r2_score(y_test,y_pred)

print(f"Mean squared error = {mse :.4f}")
print(f"r2 Score = ${r2 :.4f}")





import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

sns.scatterplot(x=x_train.values.ravel(),y=y_train.squeeze())
plt.plot(x_train,model.predict(x_train),c="r")



